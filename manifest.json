{
  "manifest_version": 3,
  "name": "ADK URL Parameters Manager",
  "description": "Add and manage URL parameters across all pages",
  "version": "1.3",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "incognito": "spanning"
}
